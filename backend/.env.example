PAPER_ATLAS_MODEL_MODE=demo
PAPER_ATLAS_MAX_RETRIES=1
PAPER_ATLAS_MAX_DOCUMENT_CHARS=120000
PAPER_ATLAS_MAX_CHUNK_CHARS=4000
PAPER_ATLAS_MAX_MODEL_INPUT_CHARS=100000
PAPER_ATLAS_FRONTEND_ORIGIN=http://localhost:3000

# AWS authentication uses a local AWS CLI profile. Do not put access keys here.
# Create/login once with: .\scripts\aws-login.ps1 -ProfileName paper-atlas
# If the organizers gave you temporary keys, configure them in
# %USERPROFILE%\.aws\credentials under the [paper-atlas] profile instead.
PAPER_ATLAS_AWS_PROFILE=paper-atlas
PAPER_ATLAS_AWS_REGION=ap-southeast-1

# Set PAPER_ATLAS_MODEL_MODE=bedrock and fill this to use a real provider.
# Example: anthropic.claude-3-5-sonnet-20241022-v2:0
PAPER_ATLAS_BEDROCK_MODEL_ID=
